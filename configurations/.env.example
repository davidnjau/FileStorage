# ── Storage provider: minio | garage ──────────────────────────────────
STORAGE_PROVIDER=minio

# ── MongoDB ───────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=fsuser
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=file_storage_db
MONGO_URI=mongodb://fsuser:change-me@mongodb:27017/file_storage_db?authSource=admin

# ── MinIO (used when STORAGE_PROVIDER=minio) ──────────────────────────
MINIO_ROOT_USER=change-me-access-key
MINIO_ROOT_PASSWORD=change-me-secret-key

# ── Garage (used when STORAGE_PROVIDER=garage) ────────────────────────
# GARAGE_ACCESS_KEY=change-me
# GARAGE_SECRET_KEY=change-me
# GARAGE_RPC_SECRET=change-me   # generate: openssl rand -hex 32
